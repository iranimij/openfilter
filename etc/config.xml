<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <openfilter>
            <general>
                <enabled>1</enabled>
                <ajax>1</ajax>
                <debug>0</debug>
            </general>
            <display>
                <expanded_groups>3</expanded_groups>
                <price_step>1</price_step>
                <layout>sidebar</layout>
                <apply_mode>instant</apply_mode>
                <sticky>0</sticky>
                <quick_bar_size>0</quick_bar_size>
                <pagination>pages</pagination>
            </display>
            <all_products>
                <enabled>0</enabled>
                <url_key>all-products</url_key>
                <title>All products</title>
            </all_products>
            <seo>
                <url_format>query</url_format>
                <nofollow_threshold>2</nofollow_threshold>
                <max_active_values>5</max_active_values>
                <meta_title></meta_title>
                <meta_description></meta_description>
                <h1></h1>
            </seo>
            <sitemap>
                <enabled>0</enabled>
                <min_products>1</min_products>
                <max_urls>5000</max_urls>
            </sitemap>
            <search>
                <count_strategy>auto</count_strategy>
            </search>
        </openfilter>
    </default>
</config>
